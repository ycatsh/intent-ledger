# Copy this file to .env and fill in real values. Never commit .env.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Directory where the SQLite database and import/export files are stored.
DATA_DIR=./data

# Number of reverse proxies in front of the app whose X-Forwarded-* headers to trust. 0 trusts none.
TRUSTED_PROXIES=0
